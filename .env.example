# Server-side only. Read by /api/chat at request time; never sent to the browser.
# Do NOT prefix these with VITE_ — Vite inlines VITE_ variables into the client
# bundle at build time, which would publish the key.
GEMINI_API_KEY=
# Optional second key. The function falls through to it if the first is rate
# limited, so a spent quota does not take the assistant offline.
GEMINI_API_KEY_2=
